        "number": {
          "gt": 0,
          "title": "Number",
          "type": "integer"
        },
        "question": {
          "title": "Question",
          "type": "string"
        },
        "answer1": {
          "title": "Answer1",
          "type": "string"
        },
        "answer2": {
          "title": "Answer2",
          "type": "string"
        },
        "answer3": {
          "title": "Answer3",
          "type": "string"
        },
        "answer4": {
          "title": "Answer4",
          "type": "string"
        },
        "correct_answer": {
          "ge": 1,
          "le": 4,
          "title": "Correct Answer",
          "type": "integer"
        },
        "category": {
          "title": "Category",
          "type": "string"
        }
      },
      "required": [
        "number",
        "question",
        "answer1",
        "answer2",
        "answer3",
        "answer4",
        "correct_answer",
        "category"
      ],
      "title": "ExamQuestion",
      "type": "object"
    }
  },
  "additionalProperties": false,
